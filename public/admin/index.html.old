<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>DVS Controller</title>
  <link rel="stylesheet" href="/admin/styles.css">
</head>
<body>
  <header class="app-header">
    <div class="brand">
      <div class="mark">DVS</div>
      <div>
        <h1>DVS Controller</h1>
        <p>Decode Video Server</p>
      </div>
    </div>
    <div class="header-actions">
      <span class="status-pill" id="serverStatus">Conectando</span>
      <span class="server-url" id="receiverUrl"></span>
      <span class="server-url" id="currentUser"></span>
      <button id="passwordBtn" type="button" class="ghost-btn">Senha</button>
      <button id="logoutBtn" type="button" class="ghost-btn">Sair</button>
    </div>
  </header>

  <nav class="view-tabs" aria-label="Areas do sistema">
    <button type="button" class="active" data-view="dashboardView">Dashboard</button>
    <button type="button" data-view="mediaView">Painel e Midia</button>
    <button type="button" data-view="webosView">Dispositivos webOS</button>
    <button type="button" data-view="tizenView">Dispositivos Tizen</button>
    <button type="button" data-view="androidView">Dispositivos Android TV</button>
    <button type="button" data-view="usersView" data-supervisor>Usuarios</button>
    <a class="dashboard-link" href="/dashboard" target="_blank" rel="noopener">Dashboard TV</a>
  </nav>

  <main class="page">
    <section id="dashboardView" class="app-view">
    <section class="metrics dashboard-metrics" aria-label="Resumo das TVs">
      <article>
        <span>TVs online</span>
        <strong id="metricOnline">0</strong>
      </article>
      <article>
        <span>TVs cadastradas</span>
        <strong id="metricTvs">0</strong>
      </article>
      <article>
        <span>Conteudos disponiveis</span>
        <strong id="metricPanels">0</strong>
      </article>
      <article>
        <span>TVs com alerta</span>
        <strong id="metricErrors">0</strong>
      </article>
    </section>
    <section class="dashboard-workspace">
      <section>
        <div class="section-toolbar">
          <div>
            <h2>Smart TVs</h2>
            <p id="tvSubtitle">Monitoramento e envio em tempo real</p>
          </div>
          <div class="filters">
            <select id="groupFilter" title="Filtrar por grupo"></select>
            <button id="refreshBtn" type="button">Atualizar</button>
          </div>
        </div>
        <div id="tvGrid" class="tv-grid"></div>
      </section>
    </section>

    </section>

    <section id="mediaView" class="app-view resource-view" hidden>
      <div class="section-toolbar">
        <div><h2>Painel e Midia</h2><p>Cadastre e organize todo o conteudo exibido nas TVs</p></div>
        <span id="resourceFeedback" class="resource-feedback" role="status" aria-live="polite"></span>
      </div>
      <nav class="resource-tabs" aria-label="Cadastros de conteudo">
        <button type="button" class="active" data-resource-view="panelsResource">Paineis</button>
        <button type="button" data-resource-view="groupsResource">Grupos</button>
        <button type="button" data-resource-view="mediaResource">Midias</button>
        <button type="button" data-resource-view="playlistsResource">Playlists</button>
      </nav>

      <section id="panelsResource" class="resource-section">
        <div class="resource-split">
          <section class="panel resource-form-panel">
            <div class="panel-title"><h2>Painel WEB</h2><span>Novo ou edicao</span></div>
            <form id="panelForm">
              <input name="name" placeholder="Nome do painel" required>
              <input name="url" placeholder="http://servidor/painel" required>
              <select name="mode">
                <option value="direct">Direto na TV</option>
                <option value="server_image">Renderizar no servidor</option>
                <option value="video">Video individual</option>
                <option value="playlist" hidden>Lista de videos</option>
                <option value="panel_playlist" hidden>Playlist de paineis</option>
              </select>
              <select name="playlistId" class="conditional-field" hidden><option value="">Selecione uma lista</option></select>
              <select name="panelPlaylistId" class="conditional-field" hidden><option value="">Selecione uma playlist de paineis</option></select>
              <select name="mediaId" class="conditional-field" hidden><option value="">Selecione um video</option></select>
              <label class="check-row conditional-field" data-video-loop hidden><input name="videoLoop" type="checkbox" checked> Repetir video continuamente</label>
              <details class="auth-config">
                <summary>Login automatico do painel</summary>
                <label class="check-row"><input name="authEnabled" type="checkbox"> Este painel exige login</label>
                <div class="auth-fields">
                  <input name="authUsername" autocomplete="off" placeholder="Usuario do painel">
                  <input name="authPassword" type="password" autocomplete="new-password" placeholder="Senha (deixe vazia para manter)">
                  <input name="usernameSelector" placeholder="Seletor do usuario (opcional)">
                  <input name="passwordSelector" placeholder="Seletor da senha (opcional)">
                  <input name="submitSelector" placeholder="Seletor do botao entrar (opcional)">
                </div>
              </details>
              <label>Zoom da pagina na TV<input name="zoom" type="range" min="0.5" max="2" step="0.05" value="1"><span id="zoomValue" class="range-value">100%</span></label>
              <div class="form-actions"><button type="submit">Salvar painel</button><button id="cancelPanelEdit" type="button" class="ghost-btn" hidden>Cancelar</button></div>
            </form>
          </section>
          <section class="panel panel-catalog">
            <div class="panel-title"><h2>Paineis cadastrados</h2><span id="panelCatalogCount">0 itens</span></div>
            <div id="panelList" class="list"></div>
          </section>
        </div>
      </section>

      <section id="groupsResource" class="resource-section" hidden>
        <section class="panel resource-narrow">
          <div class="panel-title"><h2>Grupos de TVs</h2><span>Organizacao operacional</span></div>
          <form id="groupForm" class="inline-form">
            <input name="name" placeholder="Nome do grupo" required>
            <button type="submit">Adicionar grupo</button>
          </form>
          <div id="groupList" class="list compact"></div>
        </section>
      </section>

      <section id="mediaResource" class="resource-section" hidden>
        <section class="panel">
          <div class="panel-title"><h2>Biblioteca de videos</h2><span id="uploadStatus">MP4, WebM ou OGV</span></div>
          <form id="uploadForm" class="upload-form">
            <input name="title" placeholder="Nome para exibicao">
            <input name="file" type="file" accept="video/mp4,video/webm,video/ogg" required>
            <progress id="uploadProgress" value="0" max="100" hidden></progress>
            <button type="submit">Enviar video</button>
          </form>
          <div id="mediaGrid" class="media-grid"></div>
        </section>
      </section>

      <section id="playlistsResource" class="resource-section" hidden>
        <div class="playlist-layout">
        <section class="panel playlist-editor">
          <div class="panel-title"><h2>Playlist de videos</h2><span>Disponivel automaticamente para as TVs</span></div>
          <form id="playlistForm">
            <input name="name" placeholder="Nome da lista" required>
            <div id="playlistMediaOptions" class="playlist-options"></div>
            <label class="check-row"><input name="loop" type="checkbox" checked> Repetir continuamente</label>
            <label>Exibir agora (opcional)<select name="targetTvId"><option value="">Somente disponibilizar</option></select></label>
            <div class="form-actions"><button type="submit">Salvar playlist</button><button type="button" class="ghost-btn cancel-playlist-edit" hidden>Cancelar</button></div>
          </form>
          <div id="playlistList" class="list"></div>
        </section>
        <section class="panel playlist-editor">
          <div class="panel-title"><h2>Playlist de paineis</h2><span>Links e tempo por painel</span></div>
          <form id="panelPlaylistForm">
            <input name="name" placeholder="Nome da playlist" required>
            <div id="panelPlaylistOptions" class="playlist-options"></div>
            <label class="check-row"><input name="loop" type="checkbox" checked> Repetir continuamente</label>
            <label>Exibir agora (opcional)<select name="targetTvId"><option value="">Somente disponibilizar</option></select></label>
            <div class="form-actions"><button type="submit">Salvar playlist</button><button type="button" class="ghost-btn cancel-playlist-edit" hidden>Cancelar</button></div>
          </form>
          <div id="panelPlaylistList" class="list"></div>
        </section>
        </div>
        <p class="form-help playlist-help">Ao salvar, a playlist ja fica disponivel no seletor do Dashboard. Nao e necessario criar uma reproducao ou painel separado.</p>
      </section>
    </section>

    <section id="webosView" class="app-view webos-section panel" hidden>
      <div class="section-toolbar bare">
        <div>
          <h2>Gerenciamento webOS</h2>
          <p>Instalacao, atualizacao e inicializacao remota do DVS Receiver</p>
        </div>
        <div class="cli-status">
          <span class="status-pill" id="cliStatus">Verificando CLI</span>
          <span class="server-url" id="packageStatus">IPK nao verificado</span>
        </div>
      </div>
      <form id="webosForm" class="webos-form">
        <input name="name" placeholder="Nome da TV" required>
        <input name="host" placeholder="IP da TV" required>
        <input name="port" type="number" value="9922" min="1" max="65535" title="Porta SSH">
        <input name="passphrase" type="password" autocomplete="off" placeholder="Passphrase do Key Server">
        <select name="linkedTvId" title="Vincular ao receiver cadastrado"><option value="">Sem vinculo</option></select>
        <label class="check-row"><input name="autoRenew" type="checkbox"> Renovar Dev Mode automaticamente</label>
        <label class="check-row"><input name="autoLaunch" type="checkbox"> Abrir app ao ligar</label>
        <button type="submit">Cadastrar e parear</button>
      </form>
      <p class="form-help">Na TV, abra Developer Mode, ative Developer Mode e Key Server antes do primeiro pareamento.</p>
      <div id="webosGrid" class="webos-grid"></div>
    </section>

    <section id="tizenView" class="app-view webos-section panel" hidden>
      <div class="section-toolbar bare">
        <div>
          <h2>Gerenciamento Samsung Tizen</h2>
          <p>Conexao SDB, instalacao, atualizacao e inicializacao remota do DVS Receiver</p>
        </div>
        <div class="cli-status">
          <span class="status-pill" id="tizenCliStatus">Verificando SDK</span>
          <span class="server-url" id="tizenPackageStatus">WGT nao verificado</span>
        </div>
      </div>
      <form id="tizenSdkForm" class="sdk-config">
        <label for="tizenSdkPath">Tizen Studio</label>
        <input id="tizenSdkPath" name="path" placeholder="C:\\tizen-studio" required>
        <button type="submit">Validar SDK</button>
        <button type="button" id="checkTizenProfiles" class="ghost-btn">Verificar perfis</button>
        <a href="https://developer.samsung.com/smarttv/develop/getting-started/setting-up-sdk/installing-tv-sdk.html" target="_blank" rel="noreferrer">Instalacao oficial</a>
      </form>
      <p class="form-help" id="tizenSdkHelp">O SDK e instalado separadamente para que os termos da Samsung sejam aceitos pelo administrador.</p>
      <form id="tizenForm" class="webos-form tizen-form">
        <input name="name" placeholder="Nome da TV" required>
        <input name="host" placeholder="IP da TV ou simulador" required>
        <input name="port" type="number" value="26101" min="1" max="65535" title="Porta SDB">
        <input name="profile" placeholder="Perfil de certificado Samsung">
        <select name="linkedTvId" title="Vincular ao receiver cadastrado"><option value="">Sem vinculo</option></select>
        <label class="check-row"><input name="autoLaunch" type="checkbox"> Abrir app ao ligar</label>
        <button type="submit">Cadastrar e conectar</button>
      </form>
      <p class="form-help">Na TV Samsung, ative Developer Mode, informe o IP deste servidor e reinicie a TV. A porta SDB padrao e 26101.</p>
      <div id="tizenGrid" class="webos-grid"></div>
    </section>

    <section id="usersView" class="app-view panel" hidden>
      <div class="section-toolbar bare">
        <div><h2>Usuarios e perfis</h2><p>Controle de acesso por responsabilidade operacional</p></div>
      </div>
      <form id="userForm" class="user-form">
        <input name="displayName" placeholder="Nome para exibicao" required>
        <input name="username" placeholder="Usuario" pattern="[a-z0-9._-]{3,40}" required>
        <select name="role" required>
          <option value="operator">Operador</option>
          <option value="technician">Tecnico</option>
          <option value="supervisor">Supervisor</option>
        </select>
        <input name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" placeholder="Senha inicial (minimo 12 caracteres)" required>
        <label class="check-row"><input name="mustChangePassword" type="checkbox" checked> Exigir troca no primeiro acesso</label>
        <button type="submit">Criar usuario</button>
      </form>
      <div class="role-legend">
        <span><strong>Supervisor</strong> configuracao e usuarios</span>
        <span><strong>Tecnico</strong> TVs, paineis e dispositivos</span>
        <span><strong>Operador</strong> reproducao e interacao</span>
      </div>
      <div id="userList" class="user-list"></div>
    </section>

    <section id="androidView" class="app-view webos-section panel" hidden>
      <div class="section-toolbar bare">
        <div>
          <h2>Gerenciamento Android TV</h2>
          <p>Conexao ADB, instalacao, atualizacao e inicializacao remota do DVS Receiver</p>
        </div>
        <div class="cli-status">
          <span class="status-pill" id="androidCliStatus">Verificando ADB</span>
          <span class="server-url" id="androidPackageStatus">APK nao verificado</span>
        </div>
      </div>
      <form id="androidForm" class="webos-form tizen-form">
        <input name="name" placeholder="Nome da TV" required>
        <input name="host" placeholder="IP da TV Android" required>
        <input name="port" type="number" value="5555" min="1" max="65535" title="Porta ADB">
        <select name="linkedTvId" title="Vincular ao receiver cadastrado"><option value="">Sem vinculo</option></select>
        <label class="check-row"><input name="autoLaunch" type="checkbox"> Abrir app ao ligar</label>
        <button type="submit">Cadastrar e conectar</button>
      </form>
      <p class="form-help">Na Android TV, ative Opcoes do desenvolvedor, Depuracao USB e Depuracao pela rede/ADB. Autorize este servidor quando a TV solicitar.</p>
      <div id="androidGrid" class="webos-grid"></div>
    </section>
  </main>

  <template id="tvTemplate">
    <article class="tv-card">
      <div class="tv-card-header">
        <div>
          <h3></h3>
          <p class="meta"></p>
        </div>
        <span class="status-dot"></span>
      </div>
      <div class="preview"></div>
      <div class="tv-info">
        <span class="panel-name"></span>
        <span class="last-seen"></span>
      </div>
      <div class="tv-settings">
        <input class="tvName" placeholder="Nome da TV">
        <select class="tvGroup"></select>
        <button class="saveTv" type="button">Salvar</button>
        <button class="deleteTv danger-btn" type="button">Excluir TV</button>
      </div>
      <label class="tv-zoom">
        <span>Zoom desta TV <strong class="tvZoomValue">100%</strong></span>
        <input class="tvZoom" type="range" min="0.5" max="2" step="0.05" value="1">
      </label>
      <div class="controls">
        <select class="panelSelect"></select>
        <button class="send" type="button">Enviar</button>
        <button class="reload" type="button" title="Recarregar">R</button>
        <button class="identify" type="button" title="Identificar">ID</button>
      </div>
      <p class="error-line"></p>
    </article>
  </template>

  <template id="webosTemplate">
    <article class="device-card">
      <div class="device-head">
        <div><h3></h3><p class="device-address"></p></div>
        <span class="device-state tag">Cadastrada</span>
      </div>
      <div class="device-meta"></div>
      <div class="device-settings">
        <select class="device-link" title="Receiver vinculado"></select>
        <label class="check-row"><input class="device-auto-renew" type="checkbox"> Renovacao automatica</label>
        <label class="check-row"><input class="device-auto-launch" type="checkbox"> Abrir app ao ligar</label>
      </div>
      <div class="system-update">
        <div>
          <strong>Atualizacao do sistema</strong>
          <small class="system-update-status">Nao verificada</small>
        </div>
        <input class="system-update-time" type="datetime-local" title="Horario da atualizacao">
      </div>
      <pre class="device-result"></pre>
      <div class="device-actions">
        <button type="button" data-action="test">Testar</button>
        <button type="button" data-action="launch">Iniciar app</button>
        <button type="button" data-action="install">Instalar IPK</button>
        <button type="button" data-action="update">Atualizar cliente</button>
        <button type="button" data-action="check-system-update">Verificar sistema</button>
        <button type="button" data-action="start-system-update">Atualizar sistema agora</button>
        <button type="button" data-action="schedule-system-update">Agendar sistema</button>
        <button type="button" data-action="renew">Renovar Dev Mode</button>
        <button type="button" data-action="pair" class="ghost-btn">Parear novamente</button>
        <button type="button" data-action="delete" class="danger-btn">Remover</button>
      </div>
    </article>
  </template>

  <template id="tizenTemplate">
    <article class="device-card">
      <div class="device-head">
        <div><h3></h3><p class="device-address"></p></div>
        <span class="device-state tag">Cadastrada</span>
      </div>
      <div class="device-meta"></div>
      <div class="device-settings tizen-settings">
        <select class="device-link" title="Receiver vinculado"></select>
        <input class="device-profile" placeholder="Perfil de certificado">
        <label class="check-row"><input class="device-auto-launch" type="checkbox"> Abrir app ao ligar</label>
        <button type="button" class="save-tizen">Salvar</button>
      </div>
      <pre class="device-result"></pre>
      <div class="device-actions">
        <button type="button" data-action="test">Testar</button>
        <button type="button" data-action="launch">Iniciar app</button>
        <button type="button" data-action="install">Instalar WGT</button>
        <button type="button" data-action="update">Atualizar cliente</button>
        <button type="button" data-action="package">Gerar WGT</button>
        <button type="button" data-action="close" class="ghost-btn">Encerrar app</button>
        <button type="button" data-action="uninstall" class="danger-btn">Desinstalar</button>
        <button type="button" data-action="delete" class="danger-btn">Remover cadastro</button>
      </div>
    </article>
  </template>

  <template id="androidTemplate">
    <article class="device-card">
      <div class="device-head">
        <div><h3></h3><p class="device-address"></p></div>
        <span class="device-state tag">Cadastrada</span>
      </div>
      <div class="device-meta"></div>
      <div class="device-settings tizen-settings">
        <select class="device-link" title="Receiver vinculado"></select>
        <label class="check-row"><input class="device-auto-launch" type="checkbox"> Abrir app ao ligar</label>
        <button type="button" class="save-android">Salvar</button>
      </div>
      <pre class="device-result"></pre>
      <div class="device-actions">
        <button type="button" data-action="test">Testar</button>
        <button type="button" data-action="launch">Iniciar app</button>
        <button type="button" data-action="install">Instalar APK</button>
        <button type="button" data-action="update">Atualizar cliente</button>
        <button type="button" data-action="enable-auto-launch">Ativar ao ligar</button>
        <button type="button" data-action="disable-auto-launch">Desativar ao ligar</button>
        <button type="button" data-action="close" class="ghost-btn">Encerrar app</button>
        <button type="button" data-action="uninstall" class="danger-btn">Desinstalar</button>
        <button type="button" data-action="delete" class="danger-btn">Remover cadastro</button>
      </div>
    </article>
  </template>

  <dialog id="remoteDialog" class="remote-dialog">
    <div class="remote-head">
      <div>
        <span class="remote-eyebrow">SESSAO INTERATIVA</span>
        <h2 id="remoteTitle">Controle do painel</h2>
        <p>Os comandos sao executados no navegador renderizado pelo servidor.</p>
      </div>
      <div class="remote-head-actions">
        <span id="remoteConnection" class="remote-live"><i></i> Conectando</span>
        <button id="closeRemote" type="button" class="ghost-btn" aria-label="Fechar controle">Fechar</button>
      </div>
    </div>
    <div class="remote-workspace">
      <section class="remote-stage-panel">
        <div class="remote-stage-toolbar">
          <span id="remoteResolution">1920 x 1080</span>
          <span>Clique na imagem para interagir</span>
        </div>
        <div id="remoteViewport" class="remote-viewport">
          <img id="remoteImage" alt="Painel interativo">
          <span id="remotePointer" class="remote-pointer" aria-hidden="true"></span>
          <div id="remoteLoading" class="remote-loading">Preparando visualizacao ao vivo...</div>
        </div>
        <div class="remote-stage-footer">
          <span id="remoteStatus">Aguardando imagem do painel</span>
          <span id="remoteLastAction">Nenhum comando enviado</span>
        </div>
      </section>

      <aside class="remote-sidebar">
        <section class="remote-tool">
          <div class="remote-tool-title"><strong>Entrada de texto</strong><span>Campo em foco</span></div>
          <form id="remoteForm" class="remote-text-form">
            <textarea name="text" rows="3" placeholder="Digite o texto que sera enviado" autocomplete="off"></textarea>
            <label class="check-row"><input name="replace" type="checkbox" checked> Substituir o conteudo atual</label>
            <button type="submit">Enviar texto</button>
          </form>
        </section>

        <section class="remote-tool">
          <div class="remote-tool-title"><strong>Navegacao</strong><span>Teclado remoto</span></div>
          <div class="remote-keypad">
            <button type="button" data-key="Tab">Tab</button>
            <button type="button" data-key="ArrowUp" aria-label="Seta para cima">&#8593;</button>
            <button type="button" data-key="Escape">Esc</button>
            <button type="button" data-key="ArrowLeft" aria-label="Seta para esquerda">&#8592;</button>
            <button type="button" data-key="Enter" class="key-primary">Enter</button>
            <button type="button" data-key="ArrowRight" aria-label="Seta para direita">&#8594;</button>
            <button type="button" data-key="Backspace">Apagar</button>
            <button type="button" data-key="ArrowDown" aria-label="Seta para baixo">&#8595;</button>
            <button type="button" data-key="Delete">Delete</button>
          </div>
        </section>

        <section class="remote-tool">
          <div class="remote-tool-title"><strong>Pagina</strong><span>Acoes rapidas</span></div>
          <div class="remote-page-actions">
            <button type="button" data-scroll="-720">Rolar para cima</button>
            <button type="button" data-scroll="720">Rolar para baixo</button>
            <button type="button" id="remoteReload" class="ghost-btn">Recarregar pagina</button>
          </div>
        </section>

        <section class="remote-tool remote-activity">
          <div class="remote-tool-title"><strong>Atividade</strong><button id="clearRemoteLog" type="button" class="text-btn">Limpar</button></div>
          <ol id="remoteLog" aria-live="polite"><li>Nenhum comando nesta sessao.</li></ol>
        </section>
      </aside>
    </div>
  </dialog>

  <dialog id="passwordDialog">
    <form id="passwordForm" method="dialog">
      <h2>Alterar senha</h2>
      <input name="currentPassword" type="password" placeholder="Senha atual" required>
      <input name="newPassword" type="password" minlength="12" maxlength="128" autocomplete="new-password" placeholder="Nova senha (minimo 12 caracteres)" required>
      <input name="confirmPassword" type="password" minlength="12" maxlength="128" autocomplete="new-password" placeholder="Repita a nova senha" required>
      <div class="dialog-actions">
        <button type="button" id="cancelPassword">Cancelar</button>
        <button type="submit">Salvar</button>
      </div>
    </form>
  </dialog>

  <script src="/admin/app.js"></script>
</body>
</html>
