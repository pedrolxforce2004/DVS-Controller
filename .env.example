# Rede
HOST=0.0.0.0
PORT=3080

# TLS: obrigatorio para credenciais em producao
TLS_CERT_PATH=C:\ProgramData\DVS Controller\tls\server.crt
TLS_KEY_PATH=C:\ProgramData\DVS Controller\tls\server.key
DVS_REQUIRE_ADMIN_TLS=1
# Somente laboratorio legado. Por padrao, administracao HTTP remota e bloqueada.
DVS_ALLOW_INSECURE_REMOTE_ADMIN=0
# Use apenas atras de proxy reverso confiavel que sobrescreva X-Forwarded-*.
TRUST_PROXY=0

# Sessao administrativa
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=28800000
SESSION_BIND_IP=1
MAX_SESSIONS=100

# Capacidade e limites de protecao
MAX_TVS=1000
MAX_PANELS=500
MAX_GROUPS=100
MAX_USERS=100
MAX_CONNECTIONS=1000
MAX_MJPEG_STREAMS=64
MAX_MJPEG_PER_IP=4

# Compatibilidade insegura. Nao habilitar em producao.
DVS_ALLOW_LEGACY_TV_QUERY_AUTH=0

# Autenticacao obrigatoria no ambiente de producao
DVS_ENABLE_ADMIN_AUTH=1
